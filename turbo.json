{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "deno.json",
    "deno.lock",
    ".tool-versions",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@bakery/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "BAKERY_ENV",
        "VITE_SENTRY_*",
        "SENTRY_UPLOAD_SOURCEMAPS",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "cache": false
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "startup": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "dispatch": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
