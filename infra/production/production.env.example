# Root writes separate mode-0600 files; never source this incomplete template.

# /etc/bakery/server.env
BAKERY_ENV=production
BAKERY_SERVER_HOST=127.0.0.1
BAKERY_APP_DATABASE_URL=
BAKERY_PUBLIC_BASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
# Separate preview origin, for example https://preview.<public host>; blank fails previews closed.
BAKERY_ARTIFACT_PREVIEW_ORIGIN=
BAKERY_SKILL_FILE_ROOT=/var/lib/bakery/skills
BAKERY_SECRETS_KEY_FILE=/etc/bakery/secrets.key
BAKERY_SECRETS_KEY_ID=
INNGEST_URL=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
BAKERY_SERVER_SENTRY_DSN=
BAKERY_SENTRY_ENABLED=true
BAKERY_SENTRY_ENVIRONMENT=production
BAKERY_SENTRY_TRACES_SAMPLE_RATE=0.1

# /etc/bakery/worker.env
BAKERY_ENV=production
BAKERY_SERVER_URL=
BAKERY_WORKER_STATE_DIR=/var/lib/bakery/worker
BAKERY_WORKER_ENROLLMENT_TOKEN_FILE=/var/lib/bakery/worker/enrollment-token
BAKERY_WORKER_NAME=bakery-production
BAKERY_WORKER_CAPABILITIES=git
BAKERY_WORKER_SLOTS=1
BAKERY_WORKER_DRAIN_MS=30000
BAKERY_WORKER_SENTRY_DSN=
BAKERY_SENTRY_ENABLED=true
BAKERY_SENTRY_ENVIRONMENT=production
BAKERY_SENTRY_TRACES_SAMPLE_RATE=0.1

# /etc/bakery/owner.env
DATABASE_URL=

# /etc/bakery/infra.env
POSTGRES_PASSWORD=
BAKERY_OWNER_PASSWORD=
BAKERY_APP_PASSWORD=
BAKERY_INNGEST_DATABASE_PASSWORD=
REDIS_PASSWORD=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_SDK_URL=

# /etc/bakery/backup.env
BAKERY_BACKUP_RECIPIENT=
