[Unit]
Description=Bakery API %i
After=network-online.target docker.service user@BAKERY_API_UID.service
Wants=network-online.target user@BAKERY_API_UID.service

[Service]
User=bakery-api
Group=bakery-api
EnvironmentFile=/etc/bakery/server.env
EnvironmentFile=/etc/bakery/%i.env
ExecStart=/opt/bakery/deploy/runtime.sh api %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
