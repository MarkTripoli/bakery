[Unit]
Description=Bakery public and private TLS proxy
After=network-online.target bakery-firewall.service
Requires=bakery-firewall.service
Wants=network-online.target

[Service]
User=bakery-caddy
Group=bakery-caddy
Environment=HOME=/var/lib/bakery-caddy
Environment=XDG_DATA_HOME=/var/lib/bakery-caddy
ExecStart=/usr/bin/caddy run --config /etc/bakery/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/bakery/Caddyfile --adapter caddyfile --address unix//run/bakery-caddy/admin.sock
Restart=on-failure
RestartSec=3
RuntimeDirectory=bakery-caddy
RuntimeDirectoryMode=0750
StateDirectory=bakery-caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
