# Local development settings. Copy to .env, replace every change-me /
# replace-with value, and export it (set -a; . ./.env; set +a): processes read
# the shell environment, not this file. scripts/dev/compose-up.sh writes a
# ready-made .env.<project-name> for its container stack instead.
BAKERY_ENV=development
BAKERY_SERVER_HOST=127.0.0.1
BAKERY_SERVER_PORT=8000
BAKERY_WORKER_HOST=127.0.0.1
BAKERY_WORKER_PORT=8001
# The web dev/preview server binds here and proxies /health, /livez,
# /readyz, /v1, and /api to BAKERY_SERVER_HOST/BAKERY_SERVER_PORT.
BAKERY_WEB_HOST=127.0.0.1
BAKERY_WEB_PORT=5173
# Required for production readiness; values are never returned by health routes.
DATABASE_URL=postgres://bakery:change-me@127.0.0.1:5432/bakery
BAKERY_APP_DATABASE_URL=postgres://bakery_app:change-me@127.0.0.1:5432/bakery
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
INNGEST_URL=http://127.0.0.1:8288
INNGEST_EVENT_KEY=replace-with-an-inngest-event-key

# Immutable skill bundle storage. Artifact content remains in Postgres.
# The private filesystem root is the default backend and also hosts Git import
# scratch. Object storage in Cloudflare R2 is configured by an installation
# administrator in the UI (Settings, Installation, Integrations); its
# credentials are stored encrypted in Postgres, never in this file.
# BAKERY_SKILL_FILE_ROOT=/absolute/private/skill-objects
