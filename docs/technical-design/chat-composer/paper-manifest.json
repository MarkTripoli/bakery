  "scope": "Autonomous work conversation with a simple request/guidance composer and optional saved workflow. Rich Markdown, files/long paste/skills/integrations, media/HTML previews, expandable artifact panels and side chats, open-work links, revision-pinned diffs, and agent/call/workflow activity. Existing desktop/phone and light/dark designs are refined in place.",
  "proof": "All 71 referenced PNG exports pass recorded hash and dimension checks. This refinement adds four Workspace tools specimens and refreshes six existing artifact/simulator views. The notification manifest's shared chat references are synchronized. Six chat groups retain non-overlapping computed/exported bounds after making room for the new specimens. Independent review found no material fixes. Historical comparisons describe earlier intentional revisions. Static Paper designs do not prove remote connectivity, device control, message/media behavior, accessibility behavior, responsive reflow or runtime pixel parity.",
  "review": {
    "independentDesignReview": "complete",
    "fixes": [
      "Match suggestion lists to their query.",
      "Show reference account, scope, and Remove."
    ],
    "runtimeVerification": "not implemented",
    "workspaceDesignReview": "complete",
    "workspaceFixes": [
      "44px independent phone video controls and preview/simulator actions.",
      "Explicit bold, italic, strikethrough, and nested Markdown indentation.",
      "Bounded image thumbnail with dimensions and Open, plus a separate unknown-file fallback.",
      "Expanded dark side-chat composer anchored to its panel; phone simulator caption kept within its display.",
      "Five consistently styled groups in navigation order, with no overlapping bounds."
    ],
    "workContextDesignReview": "complete; account and repository/project metadata added after independent review; final dark views checked visually",
    "workContextFixes": [
      "Disambiguate work-link search results with connected account and project/repository.",
      "Keep diff hunk counts and old/new line markers consistent.",
      "Label pending call output as unavailable rather than an enabled action.",
      "Keep phone navigation and recovery actions at least 44px high."
    ],
    "compactRunDesignReview": "complete",
    "compactRunFixes": [
      "Label every summary agents complete; Run 84 explicitly counts child agents and excludes the coordinator and ordinary checks.",
      "Keep narrow-layout elapsed time on its own line; phone Activity still fits its 844px viewport.",
      "Use disclosure chevrons for collapsible runs and stages."
    ],
    "autonomousChatReview": "complete; no material fixes",
    "autonomousChatChanges": [
      "One input for requests and guidance, optional Workflow, More and Send.",
      "Remove primary intent modes and model/harness controls; preserve resolved metadata in Activity.",
      "Allow freeform planning before work linking; agents establish authorized anchors before execution.",
      "Preserve a 44px workflow control on phone and existing panel/media/diff layouts."
    ],
    "humanPresenceReview": "complete; no material fixes",
    "humanPresenceChanges": [
      "Replace 13 text presence indicators with circular avatars and lower-right overlapping green dots.",
      "Add avatar access to three phone conversation headers.",
      "Show Here now, Viewed, and Last active details in light/dark desktop and phone specimens.",
      "Keep live expiry separate from proposed historical viewing/activity timestamps."
    ],
    "mentionsAndNotificationsReview": "complete; sidebar order synchronized after independent review",
    "mentionsAndNotificationsChanges": [
      "Typed People search, access-on-send disclosure, sent state and blocked-sharing recovery in both themes and form factors.",
