    "workspaceToolsReview": "complete; no material fixes",
    "workspaceToolsChanges": [
      "One Add panel picker with Files & artifacts, Changes, Live app, Devices, Run logs, Side chat, Context and Activity.",
      "Host-scoped device directory, distinct Open/Boot actions and explicit remote-control ownership.",
