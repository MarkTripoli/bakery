erDiagram
  direction LR
  principals {
    uuid id PK
  }
  organizations {
    uuid id PK
  }
  integration_installations {
    uuid id PK
  }
  secrets {
    uuid id PK
    uuid organization_id FK "nullable"
    text name
    uuid active_version_id FK "nullable"
    jsonb allowed_principals
    jsonb allowed_actions
    timestamp revoked_at "nullable"
    uuid integration_installation_id FK "nullable"
  }
  organizations |o..o{ secrets : "organization_id"
  secret_versions |o..o{ secrets : "active_version_id"
  integration_installations |o..o{ secrets : "integration_installation_id"
  secret_versions {
    uuid id PK
    uuid organization_id FK "nullable"
    uuid secret_id FK
    int revision
    bytea ciphertext
    bytea nonce
    text key_id
    uuid created_by FK
    timestamp expires_at "nullable"
    uuid integration_installation_id FK "nullable"
  }
  organizations |o..o{ secret_versions : "organization_id"
  secrets ||..o{ secret_versions : "secret_id"
  principals ||..o{ secret_versions : "created_by"
  integration_installations |o..o{ secret_versions : "integration_installation_id"
