{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@bakery/ui": ["../../packages/ui/src/index.ts"],
      "@bakery/integration-sdk/web": [
        "../../packages/integration-sdk/src/web-provider.ts"
      ],
      "@bakery/integration-sdk/provider": [
        "../../packages/integration-sdk/src/provider-manifest.ts"
      ],
      "@bakery/integration-linear/web": [
        "../../packages/integration-linear/src/web/mod.ts"
      ]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "../../packages/ui/src",
    "../../packages/integration-linear/src/web",
    "../../packages/integration-sdk/src/web-provider.ts",
    "../../packages/integration-sdk/src/provider-manifest.ts"
  ],
  "exclude": ["src/**/*.stories.tsx"]
}
