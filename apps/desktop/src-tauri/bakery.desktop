[Desktop Entry]
{{#if categories}}Categories={{categories}}{{/if}}
{{#if comment}}Comment={{comment}}{{/if}}
{{!-- %u hands the system's bakery:// address to the app. Without it a click on "Open the Bakery app" in
      the browser starts the app but loses the sign-in answer. --}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}MimeType={{mime_type}}{{/if}}
