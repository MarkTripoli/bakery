{
  "name": "bakery",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "deno run --allow-env --allow-net --allow-run scripts/run-stack.ts dev",
    "start": "deno run --allow-env --allow-net --allow-run scripts/run-stack.ts start",
    "server": "pnpm --filter @bakery/server start",
    "worker": "pnpm --filter @bakery/worker start",
    "startup": "pnpm --filter @bakery/server startup",
    "migrate": "pnpm --filter @bakery/server migrate",
    "auth:migrations:generate": "pnpm --filter @bakery/server auth:migrations:generate",
    "createsuperuser": "pnpm --filter @bakery/server createsuperuser",
    "dispatch": "pnpm --filter @bakery/server dispatch",
    "build": "deno check scripts/run-stack.ts scripts/run-tests.ts && turbo run build",
    "typecheck": "deno check scripts/run-stack.ts scripts/run-tests.ts && turbo run typecheck",
    "test:rails": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts rails",
    "test:unit": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts unit",
    "test:provider": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts provider",
    "test:contract": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts contract",
    "test:integration": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts integration",
    "test:recovery": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts recovery",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:security": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts security",
    "contracts:generate": "deno run --allow-read --allow-write --allow-run=git scripts/generate-contracts.ts",
    "contracts:check": "deno run --allow-read --allow-run=git scripts/generate-contracts.ts --check",
    "fmt": "deno fmt apps/server apps/worker apps/web packages/config packages/contracts packages/i18n packages/integration-sdk packages/persistence packages/ui scripts tests",
    "ui:tokens:generate": "deno run --allow-read --allow-write scripts/generate-ui-tokens.ts generate",
    "ui:tokens:check": "deno run --allow-read scripts/generate-ui-tokens.ts --check",
    "ui:stories:check": "deno run --allow-read scripts/verify-ui-stories.ts",
    "ui:architecture:check": "node scripts/check-ui-architecture.mjs",
    "ui:architecture:test": "node --test tests/rails/ui-architecture.node.mjs tests/rails/ui-catalog.node.mjs tests/rails/ui-guardrails.node.mjs tests/rails/ui-catalog-mcp.node.mjs tests/rails/ui-design-cases.node.mjs tests/rails/ui-paper-frames.node.mjs tests/rails/ui-specimen-wait.node.mjs packages/ui/tests/paper-source-profiles.node.mjs packages/ui/tests/entitlements-source-bytes.node.mjs packages/ui/tests/contracts-module-format.node.mjs",
    "test:runner-label-policy": "node --test tests/rails/runner-label-policy.node.mjs",
    "lint:suppressions": "deno run --allow-read --allow-run scripts/ci/check-suppressions.ts",
    "lint": "deno fmt --check apps/server apps/worker apps/web packages/config packages/contracts packages/i18n packages/integration-sdk packages/persistence packages/ui scripts tests && deno lint apps/server apps/worker apps/web packages/config packages/contracts packages/i18n packages/integration-sdk packages/persistence packages/ui scripts tests && pnpm lint:suppressions",
    "clean": "turbo run clean",
    "test:e2e": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts e2e",
    "test:connected": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts connected",
    "test:native": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts native",
    "hooks:install": "git config core.hooksPath .githooks",
    "catalog:literals": "deno run --allow-read --allow-write scripts/generate-catalog-literals.ts",
    "catalog:literals:check": "deno run --allow-read scripts/generate-catalog-literals.ts --check",
    "test:r2": "deno run --allow-env --allow-read --allow-run scripts/run-tests.ts r2",
    "licences:audit": "deno run --allow-read --allow-env --allow-run=pnpm,deno --allow-write=scripts/licences/dependency-licences.json scripts/licences/audit.ts --write",
    "licences:check": "deno run --allow-read --allow-env --allow-run=pnpm,deno scripts/licences/audit.ts --check"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@axe-core/playwright": "4.13.0",
    "@bakery/persistence": "workspace:*",
    "@better-auth/scim": "1.7.3",
    "@better-auth/sso": "1.7.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.13.4",
    "better-auth": "1.7.3",
    "hono": "4.13.7",
    "inngest": "4.20.0",
    "loro-crdt": "1.16.0",
    "railway": "3.13.0",
    "samlify": "2.13.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "yaml": "2.8.1",
    "zod": "4.5.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
